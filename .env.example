# Variáveis do server (configure na aba Variables da Railway)

# Referência ao Postgres criado no mesmo projeto da Railway
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Chaves PÚBLICAS dos PCs autorizados (npm run keygen -- <nome-do-pc>)
CLIENT_PUBLIC_KEYS=pc-casa:BASE64_DA_CHAVE_PUBLICA,pc-trabalho:BASE64_DA_CHAVE_PUBLICA

# Opcionais
MAX_UPLOAD_MB=50
DATABASE_SSL=false
