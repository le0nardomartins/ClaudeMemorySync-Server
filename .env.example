# Variáveis do serviço do SERVER na Railway (aba Variables do serviço do server,
# não do Postgres). As de banco são REFERÊNCIAS ao serviço Postgres: a Railway
# copia o valor e atualiza sozinha se a senha mudar.

# --- Banco: a única obrigatória ---
# Usa a rede interna (postgres.railway.internal), sem expor o banco à internet.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Alternativa à DATABASE_URL (use uma OU outra):
# PGHOST=${{Postgres.PGHOST}}
# PGPORT=${{Postgres.PGPORT}}
# PGUSER=${{Postgres.PGUSER}}
# PGPASSWORD=${{Postgres.PGPASSWORD}}
# PGDATABASE=${{Postgres.PGDATABASE}}

# --- Autenticação ---
# Chaves PÚBLICAS dos PCs autorizados (npm run keygen -- <nome-do-pc>), separadas por vírgula
CLIENT_PUBLIC_KEYS=pc-notebook-x7k2:BASE64_DA_CHAVE_PUBLICA,pc-outro:BASE64_DA_CHAVE_PUBLICA

# --- Opcionais ---
MAX_UPLOAD_MB=50
# Só "true" se usar a DATABASE_PUBLIC_URL (proxy público). Pela rede interna, deixe false.
DATABASE_SSL=false
